    {
      "id": "ci_receiver",
      "description": "Product CI receiver: full native/helper/release-generator job, including sudo and pinned tools; local unittest subsets cannot satisfy it.",
      "argv": [
        "python3",
        "-B",
        "scripts/chatops/tests/test_ci_workflow.py"
      ],
      "cwd": ".",
      "timeout_s": 600,
      "tiers": [
        "T3"
      ],
      "env_flags": [
        "TRAIN_SOURCE_SHA",
        "TRAIN_BASE_SHA",
        "TRAIN_TOOLS_SHA"
      ],
      "kind": "ci_only"
    }
