    {
      "id": "ci_source_contracts",
      "description": "Product CI source (contracts): typecheck, lint, test:unit; admin also requires standalone Docker/path checks. CI-only representative argv; never executed locally.",
      "argv": [
        "pnpm",
        "--filter",
        "@gobadminton/contracts",
