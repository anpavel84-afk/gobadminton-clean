    {
      "id": "ci_database",
      "description": "Product CI database: PostgreSQL/Docker integration and migration/security checks.",
      "argv": [
        "bash",
        "scripts/chatops/db-ci.sh"
      ],
      "cwd": ".",
      "timeout_s": 3600,
      "tiers": [
        "T3"
      ],
      "env_flags": [
        "BASE_SHA"
      ],
