# Source/test only. Disabled unless explicitly configured. No public-host support.
ADMIN_INTERNAL_APP_ENABLED=0
ADMIN_TEST_ORIGIN=http://localhost:3010
ADMIN_TEST_API_URL=http://127.0.0.1:3000

# DEV path mode requires a separately compiled ADMIN_DEV_PATH_BUILD=1 image.
# Default OFF. ADMIN_ORIGIN remains a pure origin, never includes /admin.
ADMIN_DEV_PATH_ENABLED=0
