NODE_ENV=development
APP_ENV=local
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://gobadminton:gobadminton@127.0.0.1:15432/gobadminton
PUBLIC_API_ORIGIN=http://127.0.0.1:3000
GIT_SHA=local-dev
SERVICE_NAME=gobadminton-api

# Explicit persistent Germany directory. Unset disables avatar uploads (no ephemeral fallback).
# AVATAR_MEDIA_ROOT=/absolute/development/path/avatars

# Email E1 defaults disabled. Fake transport is local NODE_ENV=test + loopback ONLY.
# No real mail credentials/provider configuration belongs to E1.
# EMAIL_AUTH_TRANSPORT=fake
# EMAIL_AUTH_HMAC_SECRET=<dedicated-test-secret-at-least-32-chars>
# EMAIL_AUTH_ENCRYPTION_SECRET=<different-dedicated-test-secret-at-least-32-chars>
# EMAIL_AUTH_RATE_SECRET=<different-dedicated-test-secret-at-least-32-chars>
# EMAIL_AUTH_GLOBAL_HOURLY_BUDGET=1000

# Admin A0a is source/test-only, defaults disabled; no production enrollment.
ADMIN_INTERNAL_ENABLED=0
ADMIN_ORIGIN=http://localhost:18540
# ADMIN_AUTH_PEPPER=<distinct dedicated synthetic test secret, >=32 chars>
# ADMIN_VK_REDIRECT_URI=http://localhost:18540/v1/admin/auth/vk/callback
# ADMIN_YANDEX_REDIRECT_URI=http://localhost:18540/v1/admin/auth/yandex/callback
