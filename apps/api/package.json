{
  "name": "@gobadminton/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"drizzle.config.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:smoke": "tsx src/database/smoke.ts",
    "db:seed-demo": "tsx src/database/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@gobadminton/contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@opentelemetry/api": "^1.9.1",
    "@simplewebauthn/server": "14.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-orm": "0.45.3",
    "fastify": "^5.11.3",
    "nodemailer": "^10.3.1",
    "openai": "7.30.0",
    "pg": "8.23.1",
    "pg-boss": "12.36.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@swc/core": "^1.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "0.31.11",
    "smtp-server": "^3.21.3",
    "tsx": "^4.20.5",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
