# Copy to /srv/gobadminton/compose/.env on the target host. Do not commit secrets.
IMAGE_TAG=replace-with-exact-candidate-sha
GIT_SHA=replace-with-exact-candidate-sha
POSTGRES_PASSWORD=replace-with-synthetic-password

# Germany public API origin (hostname, never raw VPS IP).
PUBLIC_API_ORIGIN=https://dev-api.gobadminton.ru

# Browser return origin after OAuth callback (Moscow web).
PUBLIC_WEB_ORIGIN=https://gobadminton.ru
ALLOWED_WEB_ORIGINS=https://gobadminton.ru,https://www.gobadminton.ru

# Opaque session/CSRF pepper (>=32 chars). Inject via secret store; never commit real values.
AUTH_PEPPER=replace-with-long-random-pepper-value

# Optional live provider credentials (omit until Owner provides dedicated apps).
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
# VK_REDIRECT_URI=https://gobadminton.ru/v1/auth/vk/callback
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# YANDEX_REDIRECT_URI=https://gobadminton.ru/v1/auth/yandex/callback

# Moscow web SSR → Germany API (hostname). Browser uses same-origin /v1 via nginx.
API_BASE_URL=https://dev-api.gobadminton.ru

API_HOST_PORT=18080
WEB_HOST_PORT=18082

# DEMO_PUBLIC social feature flags for the Germany `api` service (compose defaults to 1).
# Override to 0 only when intentionally disabling a surface. Do not set secrets here.
# SOCIAL_DIRECTORY_ENABLED=1
# SOCIAL_DM_ENABLED=1
# SOCIAL_INVITATIONS_ENABLED=1
# SOCIAL_GAME_CHAT_ENABLED=1
# SOCIAL_INBOX_ENABLED=1
# Live Radar availability (never auto-starts GPS). Durable compose default is 1 (Owner GitHub #65).
# Rollback: set to 0 and recreate API in a separately admitted runtime. Synthetic demo remains independent.
# SOCIAL_RADAR_ENABLED=1
# Owner/test-only comma-separated user UUIDs allowed outside admitted live Radar regions.
# SOCIAL_RADAR_GLOBAL_DEBUG_USER_IDS=
# Synthetic/internal city-scoped Radar demo (deterministic demo identities / Moscow+SPB only).
# SOCIAL_RADAR_DEMO_ENABLED=1
